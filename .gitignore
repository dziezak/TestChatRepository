# ============================
# Node.js standard .gitignore
# ============================

# Dependencies
/node_modules
/package-lock.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Environment variables
.env
.env.local
.env.*.local

# Build outputs
/dist
/build
/out
/coverage

# IDE / system files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/

# Optional npm cache directory
.npm

# Local Ollama model data (if any)
*.bin
*.gguf

